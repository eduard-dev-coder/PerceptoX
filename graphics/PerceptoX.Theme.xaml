<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0065FF" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#0057DC" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#004BC0" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#CED7E3" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="White" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#53647E" />
            <SolidColorBrush x:Key="PxInk" Color="#111B3D" />
            <SolidColorBrush x:Key="PxMuted" Color="#5C709C" />
            <SolidColorBrush x:Key="PxBlue" Color="#0065FF" />
            <SolidColorBrush x:Key="PxAccentText" Color="#0065FF" />
            <SolidColorBrush x:Key="PxLine" Color="#DBE7F9" />
            <SolidColorBrush x:Key="PxCard" Color="#F9FFFFFF" />
            <SolidColorBrush x:Key="PxSidebar" Color="#DFFFFFFF" />
            <SolidColorBrush x:Key="PxControl" Color="#FCFDFF" />
            <SolidColorBrush x:Key="PxButtonSurface" Color="#FAFCFF" />
            <SolidColorBrush x:Key="PxSubtle" Color="#F4F9FF" />
            <SolidColorBrush x:Key="PxImageSurface" Color="#EAF2FD" />
            <SolidColorBrush x:Key="PxSelected" Color="#E0EEFF" />
            <SolidColorBrush x:Key="PxHover" Color="#180065FF" />
            <SolidColorBrush x:Key="PxSuccessSurface" Color="#DDF9EB" />
            <SolidColorBrush x:Key="PxSuccessInk" Color="#075137" />
            <SolidColorBrush x:Key="PxSuccessTrack" Color="#E7F1EE" />
            <SolidColorBrush x:Key="PxSuccess" Color="#0ACB73" />
            <SolidColorBrush x:Key="PxWarningSurface" Color="#FFF8EF" />
            <SolidColorBrush x:Key="PxWarningInk" Color="#8F520B" />
            <SolidColorBrush x:Key="PxBadge" Color="#EAF1FD" />
            <SolidColorBrush x:Key="PxHeart" Color="#D92E48" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#0065FF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#0057DC" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#004BC0" />
            <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="#ECF3FF" />
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="#0065FF" />
            <LinearGradientBrush x:Key="PxBackground" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F1F8FF" /><GradientStop Color="#F8FBFF" Offset="0.65" /><GradientStop Color="#E9F3FF" Offset="1" /></LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0065FF" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#0057DC" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#004BC0" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2D4669" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="White" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#91A4C3" />
            <SolidColorBrush x:Key="PxInk" Color="#ECF2FF" />
            <SolidColorBrush x:Key="PxMuted" Color="#A6B6D2" />
            <SolidColorBrush x:Key="PxBlue" Color="#0065FF" />
            <SolidColorBrush x:Key="PxAccentText" Color="#78B4FF" />
            <SolidColorBrush x:Key="PxLine" Color="#33445F" />
            <SolidColorBrush x:Key="PxCard" Color="#1B283C" />
            <SolidColorBrush x:Key="PxSidebar" Color="#131E30" />
            <SolidColorBrush x:Key="PxControl" Color="#152236" />
            <SolidColorBrush x:Key="PxButtonSurface" Color="#23334C" />
            <SolidColorBrush x:Key="PxSubtle" Color="#1B2E48" />
            <SolidColorBrush x:Key="PxImageSurface" Color="#0F1B2C" />
            <SolidColorBrush x:Key="PxSelected" Color="#243E62" />
            <SolidColorBrush x:Key="PxHover" Color="#2878B4FF" />
            <SolidColorBrush x:Key="PxSuccessSurface" Color="#153D32" />
            <SolidColorBrush x:Key="PxSuccessInk" Color="#8BE5B6" />
            <SolidColorBrush x:Key="PxSuccessTrack" Color="#26473D" />
            <SolidColorBrush x:Key="PxSuccess" Color="#38D491" />
            <SolidColorBrush x:Key="PxWarningSurface" Color="#392C1D" />
            <SolidColorBrush x:Key="PxWarningInk" Color="#FFD399" />
            <SolidColorBrush x:Key="PxBadge" Color="#152236" />
            <SolidColorBrush x:Key="PxHeart" Color="#FF7188" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#0065FF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#287FFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#0057DC" />
            <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="#162236" />
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#273A55" />
            <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="#A1CBFF" />
            <LinearGradientBrush x:Key="PxBackground" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#111B2B" /><GradientStop Color="#152236" Offset="0.65" /><GradientStop Color="#1B2D46" Offset="1" /></LinearGradientBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <LinearGradientBrush x:Key="PxBlueGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#55B4FF" /><GradientStop Color="#005CFF" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="PxTealGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2CE5D2" /><GradientStop Color="#009EB9" Offset="1" /></LinearGradientBrush>
    <Style x:Key="PxButton" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource PxButtonSurface}" /><Setter Property="Foreground" Value="{ThemeResource PxInk}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PxLine}" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="16,10" /><Setter Property="MinHeight" Value="40" />
    </Style>
    <Style x:Key="PxPrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Background" Value="#0065FF" /><Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="24,14" /><Setter Property="MinHeight" Value="50" /><Setter Property="FontSize" Value="17" />
    </Style>
    <Style x:Key="PxBrowseButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource PxBlue}" /><Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="16,10" /><Setter Property="MinHeight" Value="40" />
    </Style>
    <Style x:Key="PxCompactActionButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource PxBlue}" /><Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="12,5" />
        <Setter Property="MinHeight" Value="32" /><Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="PxTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource PxControl}" /><Setter Property="BorderBrush" Value="{ThemeResource PxLine}" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="12,10" /><Setter Property="MinHeight" Value="42" />
        <Setter Property="Foreground" Value="{ThemeResource PxInk}" />
    </Style>
    <Style x:Key="PxCardPanel" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PxCard}" /><Setter Property="BorderBrush" Value="{ThemeResource PxLine}" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="16" /><Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="PxDialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource PxBlue}" /><Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="18,10" /><Setter Property="MinHeight" Value="40" />
    </Style>
    <Style x:Key="PxDialog" TargetType="ContentDialog">
        <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{ThemeResource PxBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource PxInk}" /><Setter Property="BorderBrush" Value="{ThemeResource PxLine}" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="20" />
        <Setter Property="PrimaryButtonStyle" Value="{StaticResource PxDialogPrimaryButton}" />
        <Setter Property="SecondaryButtonStyle" Value="{StaticResource PxButton}" /><Setter Property="CloseButtonStyle" Value="{StaticResource PxButton}" />
        <Setter Property="TitleTemplate">
            <Setter.Value><DataTemplate><Border BorderBrush="{ThemeResource PxLine}" BorderThickness="0,0,0,1" Padding="0,0,0,14"><ContentPresenter Content="{Binding}" Foreground="{ThemeResource PxInk}" /></Border></DataTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="FlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource PxBackground}" /><Setter Property="Foreground" Value="{ThemeResource PxInk}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PxLine}" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" /><Setter Property="Padding" Value="20" />
    </Style>
    <Style TargetType="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource PxCard}" /><Setter Property="Foreground" Value="{ThemeResource PxInk}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PxLine}" /><Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style x:Key="PxNavItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="16,14" /><Setter Property="Margin" Value="12,5" /><Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="FontSize" Value="15" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid x:Name="NavRoot" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="NavRoot.Opacity" Value="0.45" /></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected" />
                                <VisualState x:Name="Selected"><VisualState.Setters><Setter Target="Chrome.Background" Value="{ThemeResource PxSelected}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource PxAccentText}" /><Setter Target="Marker.Opacity" Value="1" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="SelectedUnfocused"><VisualState.Setters><Setter Target="Chrome.Background" Value="{ThemeResource PxSelected}" /><Setter Target="Presenter.Foreground" Value="{ThemeResource PxAccentText}" /><Setter Target="Marker.Opacity" Value="1" /></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Chrome" CornerRadius="8" Background="Transparent">
                            <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" Foreground="{ThemeResource PxInk}" />
                        </Border>
                        <Border x:Name="Hover" Background="{ThemeResource PxHover}" CornerRadius="8" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="Marker" Background="#0065FF" Width="3" Height="30" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
