<Page x:Class="PerceptoX.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:PerceptoX.WinUI.Localization" Background="{ThemeResource PxBackground}">
    <Grid Margin="32,24,32,20" RowSpacing="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="5">
            <TextBlock Text="{loc:UiTextExtension Key=MainWindow.Text004}" FontSize="32" FontWeight="Bold" Foreground="{ThemeResource PxInk}" />
            <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text001}" Foreground="{ThemeResource PxMuted}" TextWrapping="Wrap" />
        </StackPanel>
        <TabView x:Name="SettingsTabs" Grid.Row="1" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False" TabWidthMode="Equal">
            <TabView.Resources>
                <Style TargetType="ScrollViewer"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                <Style x:Key="SettingsCards" TargetType="StackPanel">
                    <Setter Property="Margin" Value="0,18,0,12" /><Setter Property="Spacing" Value="16" />
                    <Setter Property="MaxWidth" Value="900" /><Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
            </TabView.Resources>
            <TabViewItem Header="{loc:UiTextExtension Key=SettingsPage.Text002}" IsClosable="False">
                <TabViewItem.IconSource><FontIconSource Glyph="&#xE713;" /></TabViewItem.IconSource>
                <ScrollViewer x:Name="GeneralSettingsViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="GeneralSettingsCards" Style="{StaticResource SettingsCards}" Width="{Binding ActualWidth, ElementName=GeneralSettingsViewport}">
                        <Border Style="{StaticResource PxCardPanel}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:UiTextExtension Key=Theme.Title}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource PxInk}" />
                                <StackPanel Orientation="Horizontal" Spacing="24">
                                    <RadioButton x:Name="LightThemeOption" Content="{loc:UiTextExtension Key=Theme.Light}" GroupName="AppTheme" Checked="OnThemeChanged" Tag="light" />
                                    <RadioButton x:Name="DarkThemeOption" Content="{loc:UiTextExtension Key=Theme.Dark}" GroupName="AppTheme" Checked="OnThemeChanged" Tag="dark" />
                                </StackPanel>
                                <TextBlock Text="{loc:UiTextExtension Key=Theme.Description}" TextWrapping="Wrap" Foreground="{ThemeResource PxMuted}" />
                                <TextBlock x:Name="ThemeStatus" TextWrapping="Wrap" Foreground="{ThemeResource PxAccentText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PxCardPanel}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text003}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource PxInk}" />
                                <ComboBox x:Name="LanguagePicker" Header="{loc:UiTextExtension Key=SettingsPage.Text004}" DisplayMemberPath="DisplayName" SelectionChanged="OnLanguageChanged" HorizontalAlignment="Stretch" />
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text005}" TextWrapping="Wrap" Foreground="{ThemeResource PxMuted}" />
                                <TextBlock x:Name="LanguageStatus" TextWrapping="Wrap" Foreground="{ThemeResource PxAccentText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PxCardPanel}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text006}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource PxInk}" />
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text007}" TextWrapping="Wrap" Foreground="{ThemeResource PxMuted}" />
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text008}" TextWrapping="Wrap" Foreground="{ThemeResource PxMuted}" />
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text009}" TextWrapping="Wrap" Foreground="{ThemeResource PxMuted}" />
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text010}" TextWrapping="Wrap" Foreground="{ThemeResource PxMuted}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="{loc:UiTextExtension Key=SettingsPage.Text011}" IsClosable="False">
                <TabViewItem.IconSource><FontIconSource Glyph="&#xE721;" /></TabViewItem.IconSource>
                <ScrollViewer x:Name="SearchSettingsViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SearchSettingsCards" Style="{StaticResource SettingsCards}" Width="{Binding ActualWidth, ElementName=SearchSettingsViewport}">
                        <Border Style="{StaticResource PxCardPanel}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text012}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource PxInk}" />
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text013}" TextWrapping="Wrap" Foreground="{ThemeResource PxMuted}" />
                                <NumberBox Header="{loc:UiTextExtension Key=SettingsPage.Text014}" Minimum="1" Maximum="1000" SpinButtonPlacementMode="Compact" Value="{Binding TopN, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PxCardPanel}">
                            <StackPanel Spacing="14">
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text015}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource PxInk}" />
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text016}" TextWrapping="Wrap" Foreground="{ThemeResource PxMuted}" />
                                <Grid ColumnSpacing="18" RowSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <NumberBox Header="{loc:UiTextExtension Key=SettingsPage.Text017}" Minimum="0" Maximum="64" SpinButtonPlacementMode="Compact" Value="{Binding MaxPerceptualDistance, Mode=TwoWay}" />
                                    <NumberBox Grid.Column="1" Header="{loc:UiTextExtension Key=SettingsPage.Text018}" Minimum="0" Maximum="64" SpinButtonPlacementMode="Compact" Value="{Binding MaxDifferenceDistance, Mode=TwoWay}" />
                                    <NumberBox Grid.Row="1" Header="{loc:UiTextExtension Key=SettingsPage.Text019}" Minimum="0" Maximum="64" SpinButtonPlacementMode="Compact" Value="{Binding MaxMultiRegionDistance, Mode=TwoWay}" />
                                    <NumberBox Grid.Row="1" Grid.Column="1" Header="{loc:UiTextExtension Key=SettingsPage.Text020}" Minimum="1" Maximum="9" SpinButtonPlacementMode="Compact" Value="{Binding MinimumMatchedRegions, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="{loc:UiTextExtension Key=Settings.ExperimentalTitle}"
                            Message="{loc:UiTextExtension Key=Settings.ExperimentalMessage}" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="{loc:UiTextExtension Key=SettingsPage.Text021}" IsClosable="False">
                <TabViewItem.IconSource><FontIconSource Glyph="&#xE9E9;" /></TabViewItem.IconSource>
                <ScrollViewer x:Name="CalibrationSettingsViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CalibrationSettingsCards" DataContext="{Binding Calibration}" Style="{StaticResource SettingsCards}" Width="{Binding ActualWidth, ElementName=CalibrationSettingsViewport}">
                        <Border Style="{StaticResource PxCardPanel}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text022}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource PxInk}" />
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text023}" TextWrapping="Wrap" Foreground="{ThemeResource PxMuted}" />
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text026}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PxCardPanel}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text027}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource PxInk}" />
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text028}" TextWrapping="Wrap" Foreground="{ThemeResource PxMuted}" />
                                <Button Content="{loc:UiTextExtension Key=SettingsPage.Text029}" Command="{Binding ProposeCommand}" Style="{StaticResource PxButton}" />
                                <Button Content="{loc:UiTextExtension Key=SettingsPage.Text030}" Command="{Binding ApplyCommand}" Style="{StaticResource PxDialogPrimaryButton}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PxCardPanel}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text031}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource PxInk}" />
                                <Button Content="{loc:UiTextExtension Key=SettingsPage.Text032}" Command="{Binding RollbackCommand}" Style="{StaticResource PxButton}" />
                                <Button Content="{loc:UiTextExtension Key=SettingsPage.Text033}" Command="{Binding ResetCommand}" Style="{StaticResource PxButton}" />
                                <Button Content="{loc:UiTextExtension Key=SettingsPage.Text034}" Command="{Binding RestoreActiveCommand}" Style="{StaticResource PxButton}" />
                                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource PxMuted}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="{loc:UiTextExtension Key=SettingsPage.Text035}" IsClosable="False">
                <TabViewItem.IconSource><FontIconSource Glyph="&#xE9CE;" /></TabViewItem.IconSource>
                <ScrollViewer x:Name="MaintenanceSettingsViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="MaintenanceSettingsCards" DataContext="{Binding Maintenance}" Style="{StaticResource SettingsCards}" Width="{Binding ActualWidth, ElementName=MaintenanceSettingsViewport}">
                        <Border Style="{StaticResource PxCardPanel}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text036}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource PxInk}" />
                                <TextBlock Text="{Binding StorageLabel}" TextWrapping="Wrap" Foreground="{ThemeResource PxMuted}" />
                                <Button Content="{loc:UiTextExtension Key=SettingsPage.Text037}" Command="{Binding RefreshCommand}" Style="{StaticResource PxButton}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PxCardPanel}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text038}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource PxInk}" />
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text039}" TextWrapping="Wrap" Foreground="{ThemeResource PxMuted}" />
                                <Button Content="{loc:UiTextExtension Key=SettingsPage.Text040}" Command="{Binding ClearCacheCommand}" Style="{StaticResource PxButton}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PxCardPanel}" Background="{ThemeResource PxWarningSurface}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text041}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource PxWarningInk}" />
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text042}" TextWrapping="Wrap" Foreground="{ThemeResource PxMuted}" />
                                <Button Content="{loc:UiTextExtension Key=SettingsPage.Text043}" Command="{Binding ResetIndexCommand}" Style="{StaticResource PxButton}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PxCardPanel}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text044}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource PxInk}" />
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text045}" TextWrapping="Wrap" Foreground="{ThemeResource PxMuted}" />
                                <Button Content="{loc:UiTextExtension Key=SettingsPage.Text046}" Command="{Binding ClearReportsCommand}" Style="{StaticResource PxButton}" />
                            </StackPanel>
                        </Border>
                        <StackPanel Spacing="10">
                            <ProgressRing Width="24" Height="24" HorizontalAlignment="Left" IsActive="{Binding IsBusy}" />
                            <Button Content="{loc:UiTextExtension Key=SettingsPage.Text047}" Command="{Binding CancelCommand}" Style="{StaticResource PxButton}" />
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource PxMuted}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="{loc:UiTextExtension Key=MainWindow.Text005}" IsClosable="False">
                <TabViewItem.IconSource><FontIconSource Glyph="&#xE74C;" /></TabViewItem.IconSource>
                <ScrollViewer x:Name="ModuleSettingsViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ModuleSettingsCards" Style="{StaticResource SettingsCards}" Width="{Binding ActualWidth, ElementName=ModuleSettingsViewport}">
                        <Border Style="{StaticResource PxCardPanel}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text048}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource PxInk}" />
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text049}" FontWeight="SemiBold" Foreground="{ThemeResource PxAccentText}" />
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text050}" TextWrapping="Wrap" Foreground="{ThemeResource PxMuted}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PxCardPanel}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text051}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource PxInk}" />
                                <TextBlock Text="{Binding CodecStatus}" TextWrapping="Wrap" Foreground="{ThemeResource PxMuted}" />
                                <TextBlock Text="{loc:UiTextExtension Key=SettingsPage.Text052}" TextWrapping="Wrap" Foreground="{ThemeResource PxMuted}" />
                                <Button x:Name="ManageModulesButton" Content="{loc:UiTextExtension Key=SettingsPage.Text053}" Click="OnManageModulesClick" Style="{StaticResource PxDialogPrimaryButton}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
