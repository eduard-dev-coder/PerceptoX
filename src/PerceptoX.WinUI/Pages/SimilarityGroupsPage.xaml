<Page x:Class="PerceptoX.WinUI.Pages.SimilarityGroupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:PerceptoX.WinUI.Localization" xmlns:converters="using:PerceptoX.WinUI.Converters">
    <Page.Resources><converters:BooleanToVisibilityConverter x:Key="VisibleWhen" /></Page.Resources>
    <Grid Padding="20,12,20,16" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="{loc:UiTextExtension Key=Grouping.Title}" FontSize="32" FontWeight="Bold" Foreground="{ThemeResource PxInk}"/>
            <TextBlock Text="{loc:UiTextExtension Key=Grouping.Description}" Foreground="{ThemeResource PxMuted}" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{ThemeResource PxCard}" BorderBrush="{ThemeResource PxLine}" BorderThickness="1" CornerRadius="12" Padding="14">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource PxTextBox}" Text="{Binding FolderText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:UiTextExtension Key=Grouping.FolderHint}" IsEnabled="{Binding IsIdle}"/>
                    <Button Grid.Column="1" Command="{Binding AddFolderCommand}" Content="{loc:UiTextExtension Key=Grouping.AddFolder}" Style="{StaticResource PxCompactActionButton}"/>
                    <Button Grid.Column="2" Command="{Binding BrowseCommand}" Content="{loc:UiTextExtension Key=BatchMatchPage.Text007}" Style="{StaticResource PxBrowseButton}"/>
                </Grid>
                <ListView ItemsSource="{Binding Folders}" MaxHeight="84" SelectionMode="None" IsEnabled="{Binding IsIdle}">
                    <ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding}" Foreground="{ThemeResource PxInk}"/>
                        <Button Grid.Column="1" Content="✕" Click="RemoveFolderClick" ToolTipService.ToolTip="{loc:UiTextExtension Key=Grouping.RemoveFolder}" Style="{StaticResource PxButton}" Padding="8,2"/>
                    </Grid></DataTemplate></ListView.ItemTemplate>
                </ListView>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <CheckBox Content="{loc:UiTextExtension Key=Grouping.EntireIndex}" IsChecked="{Binding EntireIndex,Mode=TwoWay}" IsEnabled="{Binding IsIdle}" VerticalAlignment="Center"/>
                    <NumberBox Grid.Column="1" Header="{loc:UiTextExtension Key=Grouping.Threshold}" Value="{Binding MinimumScore,Mode=TwoWay}" Minimum="97" Maximum="100" SpinButtonPlacementMode="Compact" IsEnabled="{Binding IsIdle}" ToolTipService.ToolTip="{loc:UiTextExtension Key=Grouping.ScoreHint}"/>
                    <Button Grid.Column="2" Command="{Binding AnalyzeCommand}" Content="{loc:UiTextExtension Key=Grouping.Analyze}" Style="{StaticResource PxPrimaryButton}" VerticalAlignment="Bottom"/>
                    <Button Grid.Column="3" Command="{Binding CancelCommand}" Content="{loc:UiTextExtension Key=ModuleManagerDialog.Text004}" Style="{StaticResource PxButton}" VerticalAlignment="Bottom" Visibility="{Binding IsBusy,Converter={StaticResource VisibleWhen}}"/>
                </Grid>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="{Binding Summary}" Foreground="{ThemeResource PxMuted}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Summary}"/>
            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:UiTextExtension Key=Grouping.SelectBest}" Command="{Binding SelectBestCommand}" Style="{StaticResource PxCompactActionButton}"/>
                    <Button Content="{loc:UiTextExtension Key=Grouping.Invert}" Command="{Binding InvertSelectionCommand}" Style="{StaticResource PxCompactActionButton}"/>
                    <Button Content="{loc:UiTextExtension Key=BatchMatchPage.Text028}" Command="{Binding CopyCommand}" Style="{StaticResource PxCompactActionButton}"/>
                    <Button Content="CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource PxCompactActionButton}"/>
                    <Button Content="HTML" Command="{Binding ExportHtmlCommand}" Style="{StaticResource PxCompactActionButton}"/>
                    <TextBlock Text="{Binding SelectionLabel}" Foreground="{ThemeResource PxInk}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{ThemeResource PxCard}" BorderBrush="{ThemeResource PxLine}" BorderThickness="1" CornerRadius="12" Padding="8">
                <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ListView x:Name="GroupList" ItemsSource="{Binding Groups}" SelectionChanged="GroupChanged" IsEnabled="{Binding IsIdle}" HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate><DataTemplate>
                            <StackPanel Spacing="4" Padding="4,8">
                                <TextBlock Text="{Binding GroupLabel}" FontWeight="SemiBold" Foreground="{ThemeResource PxAccentText}"/>
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Image Source="{Binding Thumbnail}" Width="64" Height="48" Stretch="Uniform"/>
                                    <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Path}" Foreground="{ThemeResource PxInk}"/>
                                        <TextBlock Text="{Binding Metadata}" FontSize="11" Foreground="{ThemeResource PxMuted}" TextTrimming="CharacterEllipsis"/></StackPanel>
                                </Grid>
                            </StackPanel>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Button Content="‹" Command="{Binding PreviousGroupsCommand}" Style="{StaticResource PxButton}"/>
                        <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Foreground="{ThemeResource PxInk}"/>
                        <Button Content="›" Command="{Binding NextGroupsCommand}" Style="{StaticResource PxButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{ThemeResource PxCard}" BorderBrush="{ThemeResource PxLine}" BorderThickness="1" CornerRadius="12" Padding="10">
                <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="{Binding ActiveGroupLabel}" Foreground="{ThemeResource PxInk}" FontSize="18" FontWeight="Bold"/>
                    <ListView Grid.Row="1" ItemsSource="{Binding Members}" SelectionMode="None" IsEnabled="{Binding IsIdle}" HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="10" Padding="4,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsSelected,Mode=TwoWay}" VerticalAlignment="Center"/>
                            <Image Grid.Column="1" Source="{Binding Thumbnail}" Width="100" Height="80" Stretch="Uniform"/>
                            <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Path}" Foreground="{ThemeResource PxInk}"/>
                                <TextBlock Text="{Binding Evidence}" FontSize="12" Foreground="{ThemeResource PxAccentText}"/>
                                <TextBlock Text="{Binding Metadata}" FontSize="12" Foreground="{ThemeResource PxMuted}"/>
                                <TextBlock Text="{Binding Path}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Path}" Foreground="{ThemeResource PxMuted}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Score}" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource PxAccentText}"/>
                                <Button Content="{Binding CompareLabel}" Click="CompareClick" Style="{StaticResource PxCompactActionButton}" IsEnabled="{Binding CanCompare}"/>
                            </StackPanel>
                        </Grid></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button Content="‹" Command="{Binding PreviousMembersCommand}" Style="{StaticResource PxButton}"/>
                        <TextBlock Text="{Binding MemberPageLabel}" VerticalAlignment="Center" Foreground="{ThemeResource PxInk}"/>
                        <Button Content="›" Command="{Binding NextMembersCommand}" Style="{StaticResource PxButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="4" Spacing="4">
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy,Converter={StaticResource VisibleWhen}}"/>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{ThemeResource PxMuted}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding StatusMessage}"/>
        </StackPanel>
    </Grid>
</Page>
