<Page
    x:Class="PerceptoX.WinUI.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:PerceptoX.WinUI.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource PxBackground}">
    <Page.Resources><Style TargetType="Button" BasedOn="{StaticResource PxButton}" /><Style TargetType="TextBox" BasedOn="{StaticResource PxTextBox}" /></Page.Resources>
    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock
                FontSize="32" FontWeight="Bold" Foreground="{ThemeResource PxInk}"
                Text="{loc:UiTextExtension Key=SearchPage.Text001}"
                AutomationProperties.HeadingLevel="Level1" />
            <TextBlock
                Text="{loc:UiTextExtension Key=SearchPage.Text002}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,8,0,0" ColumnSpacing="12" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Header="{loc:UiTextExtension Key=SearchPage.Text003}"
                IsEnabled="{Binding Workspace.IsEditable}"
                Text="{Binding SelectedImagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.Name="{loc:UiTextExtension Key=SearchPage.Text004}" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Command="{Binding BrowseImageCommand}"
                Style="{StaticResource PxBrowseButton}"
                Content="{loc:UiTextExtension Key=IndexingPage.Text005}"
                AutomationProperties.Name="{loc:UiTextExtension Key=SearchPage.Text005}" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Command="{Binding SearchCommand}" Content="{loc:UiTextExtension Key=SearchPage.Text006}" Style="{StaticResource PxDialogPrimaryButton}" />
            <Button Grid.Column="1" Command="{Binding CancelCommand}" Content="{loc:UiTextExtension Key=BatchMatchPage.Text012}" />
            <ProgressRing
                Grid.Column="2"
                Width="24"
                Height="24"
                IsActive="{Binding IsBusy}"
                AutomationProperties.Name="{loc:UiTextExtension Key=SearchPage.Text007}" />
            <TextBlock
                Grid.Column="3"
                VerticalAlignment="Center"
                Text="{Binding StatusMessage}"
                TextWrapping="Wrap"
                AutomationProperties.LiveSetting="Polite" />
        </Grid>

        <GridView
            x:Name="ResultsGrid"
            Grid.Row="3"
            ItemsSource="{Binding Results}"
            IsItemClickEnabled="False"
            SelectionMode="Single"
            ScrollViewer.HorizontalScrollMode="Disabled"
            AutomationProperties.Name="{loc:UiTextExtension Key=SearchPage.Text008}">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid ItemWidth="260" ItemHeight="310" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Grid Width="244" Height="294" Padding="8" AutomationProperties.Name="{Binding AccessibilityLabel}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="220" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Background="{ThemeResource PxCard}" BorderBrush="{ThemeResource PxLine}" BorderThickness="1" CornerRadius="12">
                            <Image Stretch="Uniform" AutomationProperties.AccessibilityView="Raw">
                                <Image.Source>
                                    <BitmapImage UriSource="{Binding ThumbnailUri}" DecodePixelWidth="256" />
                                </Image.Source>
                            </Image>
                        </Border>
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            FontWeight="SemiBold"
                            Text="{Binding ScoreLabel}"
                            AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock
                            Grid.Row="2"
                            Text="{Binding DistanceLabel}"
                            TextTrimming="CharacterEllipsis"
                            AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock
                            Grid.Row="3"
                            Text="{Binding FilePath}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding FilePath}"
                            AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
